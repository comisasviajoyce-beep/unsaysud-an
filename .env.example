# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# MySQL connection (server-side only; never use a VITE_ prefix).
# For Railway's Vercel integration, MYSQLHOST/MYSQLPORT/MYSQLUSER/
# MYSQLPASSWORD/MYSQLDATABASE are also accepted by the backend.
DB_HOST="YOUR_MYSQL_HOST"
DB_PORT="3306"
DB_USER="YOUR_MYSQL_USER"
DB_PASSWORD="YOUR_MYSQL_PASSWORD"
DB_NAME="YOUR_MYSQL_DATABASE"
# Set true only if your MySQL provider requires TLS.
DB_SSL="false"
# Per Vercel function instance; keep conservative for serverless deployments.
DB_CONNECTION_LIMIT="3"
